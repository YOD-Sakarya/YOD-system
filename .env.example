# Existing Yod_System.env is read automatically. Values here override it.
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Set to neon only after auth:setup and Neon Auth configuration are complete.
AUTH_PROVIDER=legacy
# NEON_AUTH_URL=https://your-branch.neonauth.region.aws.neon.tech/neondb/auth
# Optional standard PostgreSQL URL; otherwise ConnectionStrings__DefaultConnection is used.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# JWT_SECRET=replace-with-at-least-32-random-characters
# CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
