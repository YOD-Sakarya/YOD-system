# Existing Yod_System.env is read automatically. Values here override it.
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Better Auth is the default. Configure Neon Auth and run auth:setup before starting.
AUTH_PROVIDER=legacy
# NEON_AUTH_URL=https://your-branch.neonauth.region.aws.neon.tech/neondb/auth
# Server-only Neon management access for provisioning and replacing users.
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_BRANCH_ID=
# Optional standard PostgreSQL URL; otherwise ConnectionStrings__DefaultConnection is used.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# JWT_SECRET=replace-with-at-least-32-random-characters
# CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
